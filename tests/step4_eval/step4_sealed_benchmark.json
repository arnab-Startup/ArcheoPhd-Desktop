    "negative_rejection_specificity_pct": 100.0,
    "negative_rejection_wilson_lower_pct": 88.7,
    "positive_attribution_precision_pct": 96.7,
    "positive_attribution_max_misses": 1,
    "positive_attribution_wilson_lower_pct": 83.3,
    "unit_preservation_accuracy_pct": 100.0,
    "auto_commit_permitted_on_pass": false
  },
